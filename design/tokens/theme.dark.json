{
  "$description": "Talyxel Park — dark theme, derived from the Parkmakers Figma palette. Same token names as theme.light.json; in Figma these are the two modes of one collection.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#071827", "$description": "Page background" },
    "bg-deep": { "$value": "#051220", "$description": "Sunken areas: map surroundings, empty photo slots" },
    "surface": { "$value": "#0d2238", "$description": "Cards, panels, dialogs, the top bar" },
    "surface-2": { "$value": "#112942", "$description": "Inset blocks inside cards" },
    "ink": { "$value": "#eef2f5", "$description": "Main text" },
    "ink-2": { "$value": "#b5ad9f", "$description": "Secondary text" },
    "ink-3": { "$value": "#8a8477", "$description": "Hints, timestamps, placeholders" },
    "line": { "$value": "#1d3550", "$description": "Borders and dividers" },
    "line-strong": { "$value": "#2a4664", "$description": "Input borders" },
    "brand": { "$value": "#b8c977", "$description": "Park green: primary buttons, links, progress" },
    "brand-strong": { "$value": "#dceab2", "$description": "Text on brand-soft; primary hover" },
    "brand-soft": { "$value": "#1e3322", "$description": "Mint: zoo chips, quick-link tile, selected states" },
    "brand-ink": { "$value": "#0a2239", "$description": "Text on brand" },
    "cta": { "$value": "#dceab2", "$description": "Lime primary buttons (the landing palette)" },
    "cta-ink": { "$value": "#0a2239", "$description": "Text on cta" },
    "cta-hover": { "$value": "#eef5d6", "$description": "Primary button hover" },
    "accent": { "$value": "#ef9a5a", "$description": "Design-motivation label, highlights" },
    "accent-soft": { "$value": "#3a2d1c", "$description": "Beige: design-motivation boxes, survey callouts" },
    "accent-ink": { "$value": "#f4bb8c", "$description": "Text on accent-soft" },
    "danger": { "$value": "#e5796d" },
    "danger-soft": { "$value": "#3b2220" },
    "info": { "$value": "#7f9bff" },
    "coaster": { "$value": "#ff5c96", "$description": "Theme-park pink" },
    "coaster-soft": { "$value": "#3d1e2b" },
    "coaster-ink": { "$value": "#ff9cc0", "$description": "Text on coaster-soft" },
    "lavender": { "$value": "#15304a", "$description": "Social quick-link tile" },
    "cream": { "$value": "#2e2a20", "$description": "Date chip on the welcome banner" },
    "hero": { "$value": "#0d2a45", "$description": "Welcome banner and profile card background" },
    "deep": { "$value": "#12304d", "$description": "Dark green cards (next step, design principle)" },
    "navy": { "$value": "#181a3d", "$description": "Theme-park planner bar (Figma: Neon Pier)" },
    "lp-navy": { "$value": "#0a2239", "$description": "Landing: deep navy hero background (same in both themes)" },
    "lp-lime": { "$value": "#dceab2", "$description": "Landing: pastel lime primary buttons" },
    "lp-sage": { "$value": "#a8ccc9", "$description": "Landing: sage teal tags, poll bars, active highlights" },
    "lp-olive": { "$value": "#60712f", "$description": "Landing: olive category pills" },
    "lp-taupe": { "$value": "#716a5c", "$description": "Landing: taupe borders and secondary text on light sections" },
    "on-dark": { "$value": "#c8d0cb", "$description": "Body text on hero/deep" },
    "on-dark-2": { "$value": "#a9bdb0", "$description": "Small text on deep" },
    "lime": { "$value": "#dceab2", "$description": "Labels and progress on dark green" },
    "poll-bg": { "$value": "#0f2438", "$description": "Question box inside posts" },
    "poll-line": { "$value": "#22405c" },
    "positive": { "$value": "#b8c977", "$description": "Stats going up" },
    "heart": { "$value": "#ff5c96", "$description": "Likes and the notification badge" },
    "ground": { "$value": "#2c3826", "$description": "Map ground" },
    "ground-ink": { "$value": "#e4ecda", "$description": "Text on the map ground" },
    "ground-line": { "$value": "#dcebd212", "$description": "Minor grid lines" },
    "ground-line-major": { "$value": "#dcebd224", "$description": "Major grid lines" },
    "ground-tuft": { "$value": "#a8cf8424", "$description": "Grass speckles on the map ground" },
    "hedge": { "$value": "#47653a", "$description": "Hedge around the edge of a park map" },
    "ground-glow": { "$value": "#d6efc008", "$description": "Sunny patches on the map ground" },
    "ground-shade": { "$value": "#00000021", "$description": "Shaded patches on the map ground" },
    "map-border": { "$value": "#dcebd240", "$description": "Edge of the map" },
    "dots": { "$value": "#eef2f512", "$description": "Dotted backdrop behind maps" },
    "selection": { "$value": "#2b4a2a", "$description": "Selected text" },
    "glass": { "$value": "#0d2238eb", "$description": "Floating pills and labels over maps" },
    "nav-bg": { "$value": "#0d2238", "$description": "Top navigation" },
    "nav-bg-solid": { "$value": "#0d2238f5", "$description": "Bottom tab bar on phones" },
    "hover-tint": { "$value": "#eef2f50f", "$description": "Hover background for quiet buttons" },
    "focus-ring": { "$value": "#b8c9774d", "$description": "Glow around focused inputs" },
    "backdrop": { "$value": "#000000a3", "$description": "Behind dialogs" },
    "inverse-bg": { "$value": "#eef2f5", "$description": "Toasts, drawing hints, map labels" },
    "inverse-ink": { "$value": "#0a2239" },
    "inverse-muted": { "$value": "#5b6b7c" }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-sm": { "$value": [{ "color": "#00000059", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "shadow": { "$value": [{ "color": "#00000066", "offsetX": "0px", "offsetY": "10px", "blur": "30px", "spread": "0px" }] },
    "shadow-lg": {
      "$value": [
        { "color": "#00000066", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" },
        { "color": "#000000b3", "offsetX": "0px", "offsetY": "24px", "blur": "60px", "spread": "-20px" }
      ]
    }
  }
}
