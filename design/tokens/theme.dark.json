{
  "$description": "Talyxel Park — dark theme. Same token names as theme.light.json; in Figma these are the two modes of one collection.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#121714", "$description": "Page background" },
    "bg-deep": { "$value": "#0d110e", "$description": "Sunken areas: map surroundings, empty photo slots" },
    "surface": { "$value": "#1a201c", "$description": "Cards, panels, dialogs" },
    "surface-2": { "$value": "#1f2621", "$description": "Inset blocks inside cards" },
    "ink": { "$value": "#e7ece6", "$description": "Main text" },
    "ink-2": { "$value": "#b2bdb5", "$description": "Secondary text" },
    "ink-3": { "$value": "#808c84", "$description": "Hints, timestamps" },
    "line": { "$value": "#2a332d", "$description": "Borders and dividers" },
    "line-strong": { "$value": "#3a463e", "$description": "Input borders" },
    "brand": { "$value": "#5aa577", "$description": "Park green: primary buttons, active states" },
    "brand-strong": { "$value": "#a3d9b5", "$description": "Text on brand-soft; primary hover" },
    "brand-soft": { "$value": "#1e3527", "$description": "Tinted backgrounds: tips, friends chip, headline stats" },
    "brand-ink": { "$value": "#0f1a13", "$description": "Text on brand" },
    "accent": { "$value": "#e8954f", "$description": "Publish, surveys, highlights" },
    "accent-soft": { "$value": "#3a2919", "$description": "Survey callouts" },
    "accent-ink": { "$value": "#f2b07a", "$description": "Text on accent-soft" },
    "danger": { "$value": "#e5796d" },
    "danger-soft": { "$value": "#3b2220" },
    "info": { "$value": "#6fa8de" },
    "coaster": { "$value": "#e07c68", "$description": "Theme-park badges" },
    "coaster-soft": { "$value": "#3b241f" },
    "positive": { "$value": "#72c890", "$description": "Stats going up" },
    "heart": { "$value": "#ff5c75", "$description": "Likes and the notification badge" },
    "ground": { "$value": "#2c3826", "$description": "Map ground" },
    "ground-ink": { "$value": "#e4ecda", "$description": "Text on the map ground" },
    "ground-line": { "$value": "#dcebd212", "$description": "Minor grid lines" },
    "ground-line-major": { "$value": "#dcebd224", "$description": "Major grid lines" },
    "map-border": { "$value": "#dcebd240", "$description": "Edge of the map" },
    "dots": { "$value": "#e7ece612", "$description": "Dotted backdrop behind maps" },
    "selection": { "$value": "#2d4a36", "$description": "Selected text" },
    "glass": { "$value": "#1a201ce6", "$description": "Floating labels over maps" },
    "nav-bg": { "$value": "#121714e0", "$description": "Blurred top navigation" },
    "nav-bg-solid": { "$value": "#121714f5", "$description": "Bottom tab bar on phones" },
    "hover-tint": { "$value": "#e7ece60f", "$description": "Hover background for quiet buttons" },
    "focus-ring": { "$value": "#5aa5774d", "$description": "Glow around focused inputs" },
    "backdrop": { "$value": "#000000a3", "$description": "Behind dialogs" },
    "inverse-bg": { "$value": "#e7ece6", "$description": "Toasts and drawing hints" },
    "inverse-ink": { "$value": "#1a201c" },
    "inverse-muted": { "$value": "#56645b" }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-sm": { "$value": [{ "color": "#00000059", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "shadow": {
      "$value": [
        { "color": "#00000059", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#00000080", "offsetX": "0px", "offsetY": "6px", "blur": "20px", "spread": "-8px" }
      ]
    },
    "shadow-lg": {
      "$value": [
        { "color": "#00000066", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" },
        { "color": "#000000b3", "offsetX": "0px", "offsetY": "22px", "blur": "50px", "spread": "-18px" }
      ]
    }
  }
}
