{
  "$description": "Talyxel Park — light theme (the default). Same token names as theme.dark.json; in Figma these are the two modes of one collection.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#f4f1e8", "$description": "Page background" },
    "bg-deep": { "$value": "#ebe6d8", "$description": "Sunken areas: map surroundings, empty photo slots" },
    "surface": { "$value": "#ffffff", "$description": "Cards, panels, dialogs" },
    "surface-2": { "$value": "#faf8f2", "$description": "Inset blocks inside cards" },
    "ink": { "$value": "#1c2a21", "$description": "Main text" },
    "ink-2": { "$value": "#4b5a50", "$description": "Secondary text" },
    "ink-3": { "$value": "#85918a", "$description": "Hints, timestamps" },
    "line": { "$value": "#e3ddcd", "$description": "Borders and dividers" },
    "line-strong": { "$value": "#d3cbb6", "$description": "Input borders" },
    "brand": { "$value": "#2f6b47", "$description": "Park green: primary buttons, active states" },
    "brand-strong": { "$value": "#23543a", "$description": "Text on brand-soft; primary hover" },
    "brand-soft": { "$value": "#e2eee3", "$description": "Tinted backgrounds: tips, friends chip, headline stats" },
    "brand-ink": { "$value": "#f4f1e8", "$description": "Text on brand" },
    "accent": { "$value": "#d9813a", "$description": "Publish, surveys, highlights" },
    "accent-soft": { "$value": "#fbeadb", "$description": "Survey callouts" },
    "accent-ink": { "$value": "#a85a1c", "$description": "Text on accent-soft" },
    "danger": { "$value": "#b8443a" },
    "danger-soft": { "$value": "#f8e3e0" },
    "info": { "$value": "#3f7cb8" },
    "coaster": { "$value": "#b24634", "$description": "Theme-park badges" },
    "coaster-soft": { "$value": "#f8e4df" },
    "positive": { "$value": "#2e7d4a", "$description": "Stats going up" },
    "heart": { "$value": "#e2445c", "$description": "Likes and the notification badge" },
    "ground": { "$value": "#cdd9b0", "$description": "Map ground" },
    "ground-ink": { "$value": "#1d2b1f", "$description": "Text on the map ground" },
    "ground-line": { "$value": "#364f2821", "$description": "Minor grid lines" },
    "ground-line-major": { "$value": "#364f2842", "$description": "Major grid lines" },
    "map-border": { "$value": "#364f2873", "$description": "Edge of the map" },
    "dots": { "$value": "#1c2a2117", "$description": "Dotted backdrop behind maps" },
    "selection": { "$value": "#cfe3c9", "$description": "Selected text" },
    "glass": { "$value": "#ffffffe6", "$description": "Floating labels over maps" },
    "nav-bg": { "$value": "#faf8f2e0", "$description": "Blurred top navigation" },
    "nav-bg-solid": { "$value": "#faf8f2f5", "$description": "Bottom tab bar on phones" },
    "hover-tint": { "$value": "#1c2a210d", "$description": "Hover background for quiet buttons" },
    "focus-ring": { "$value": "#2f6b4726", "$description": "Glow around focused inputs" },
    "backdrop": { "$value": "#141e1873", "$description": "Behind dialogs" },
    "inverse-bg": { "$value": "#1c2a21", "$description": "Toasts and drawing hints" },
    "inverse-ink": { "$value": "#eef1ea" },
    "inverse-muted": { "$value": "#a5b1a9" }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-sm": { "$value": [{ "color": "#1c2a210f", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "shadow": {
      "$value": [
        { "color": "#1c2a210d", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#1c2a212e", "offsetX": "0px", "offsetY": "6px", "blur": "20px", "spread": "-8px" }
      ]
    },
    "shadow-lg": {
      "$value": [
        { "color": "#1c2a2114", "offsetX": "0px", "offsetY": "2px", "blur": "6px", "spread": "0px" },
        { "color": "#1c2a2159", "offsetX": "0px", "offsetY": "22px", "blur": "50px", "spread": "-18px" }
      ]
    }
  }
}
