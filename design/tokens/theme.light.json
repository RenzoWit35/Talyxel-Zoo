{
  "$description": "Talyxel Park — light theme (the default), from the Parkmakers Figma design. Same token names as theme.dark.json; in Figma these are the two modes of one collection.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#f3f1eb", "$description": "Page background" },
    "bg-deep": { "$value": "#ebe8df", "$description": "Sunken areas: map surroundings, empty photo slots" },
    "surface": { "$value": "#ffffff", "$description": "Cards, panels, dialogs, the top bar" },
    "surface-2": { "$value": "#f8f7f3", "$description": "Inset blocks inside cards" },
    "ink": { "$value": "#17201b", "$description": "Main text" },
    "ink-2": { "$value": "#68716b", "$description": "Secondary text" },
    "ink-3": { "$value": "#929b94", "$description": "Hints, timestamps, placeholders" },
    "line": { "$value": "#dce0da", "$description": "Borders and dividers" },
    "line-strong": { "$value": "#c8cdc6", "$description": "Input borders" },
    "brand": { "$value": "#3c674f", "$description": "Park green: primary buttons, links, progress" },
    "brand-strong": { "$value": "#264638", "$description": "Text on brand-soft; primary hover" },
    "brand-soft": { "$value": "#ddeadf", "$description": "Mint: zoo chips, quick-link tile, selected states" },
    "brand-ink": { "$value": "#ffffff", "$description": "Text on brand" },
    "accent": { "$value": "#e0782f", "$description": "Design-motivation label, highlights" },
    "accent-soft": { "$value": "#f1e7d3", "$description": "Beige: design-motivation boxes, survey callouts" },
    "accent-ink": { "$value": "#b25a1c", "$description": "Text on accent-soft" },
    "danger": { "$value": "#c0453b" },
    "danger-soft": { "$value": "#f8e3e0" },
    "info": { "$value": "#3157e3" },
    "coaster": { "$value": "#ff4d8d", "$description": "Theme-park pink" },
    "coaster-soft": { "$value": "#ffe1ed" },
    "coaster-ink": { "$value": "#a81754", "$description": "Text on coaster-soft" },
    "lavender": { "$value": "#e8e6f6", "$description": "Social quick-link tile" },
    "cream": { "$value": "#eee5d2", "$description": "Date chip on the welcome banner" },
    "hero": { "$value": "#17201b", "$description": "Welcome banner and profile card background" },
    "deep": { "$value": "#243e31", "$description": "Dark green cards (next step, design principle)" },
    "navy": { "$value": "#1d1f4a", "$description": "Theme-park planner bar (Figma: Neon Pier)" },
    "on-dark": { "$value": "#c8d0cb", "$description": "Body text on hero/deep" },
    "on-dark-2": { "$value": "#b8c9be", "$description": "Small text on deep" },
    "lime": { "$value": "#b9d47b", "$description": "Labels and progress on dark green" },
    "poll-bg": { "$value": "#f6f8f2", "$description": "Question box inside posts" },
    "poll-line": { "$value": "#d9e1d2" },
    "positive": { "$value": "#3c674f", "$description": "Stats going up" },
    "heart": { "$value": "#ff4d8d", "$description": "Likes and the notification badge" },
    "ground": { "$value": "#cdd9b0", "$description": "Map ground" },
    "ground-ink": { "$value": "#1d2b1f", "$description": "Text on the map ground" },
    "ground-line": { "$value": "#364f2821", "$description": "Minor grid lines" },
    "ground-line-major": { "$value": "#364f2842", "$description": "Major grid lines" },
    "map-border": { "$value": "#364f2873", "$description": "Edge of the map" },
    "dots": { "$value": "#17201b17", "$description": "Dotted backdrop behind maps" },
    "selection": { "$value": "#ddeadf", "$description": "Selected text" },
    "glass": { "$value": "#ffffffeb", "$description": "Floating pills and labels over maps" },
    "nav-bg": { "$value": "#ffffff", "$description": "Top navigation" },
    "nav-bg-solid": { "$value": "#fffffff5", "$description": "Bottom tab bar on phones" },
    "hover-tint": { "$value": "#17201b0d", "$description": "Hover background for quiet buttons" },
    "focus-ring": { "$value": "#3c674f33", "$description": "Glow around focused inputs" },
    "backdrop": { "$value": "#17201b80", "$description": "Behind dialogs" },
    "inverse-bg": { "$value": "#17201b", "$description": "Toasts, drawing hints, map labels" },
    "inverse-ink": { "$value": "#ffffff" },
    "inverse-muted": { "$value": "#a9b4ac" }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-sm": { "$value": [{ "color": "#17201b0d", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "shadow": { "$value": [{ "color": "#17201b12", "offsetX": "0px", "offsetY": "10px", "blur": "30px", "spread": "0px" }] },
    "shadow-lg": {
      "$value": [
        { "color": "#17201b14", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" },
        { "color": "#17201b38", "offsetX": "0px", "offsetY": "24px", "blur": "60px", "spread": "-20px" }
      ]
    }
  }
}
