{
  "$description": "Talyxel Park — light theme (the default): navy, pastel lime, sage, olive and taupe on warm off-white. Same token names as theme.dark.json; in Figma these are the two modes of one collection.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#f3f1eb", "$description": "Page background" },
    "bg-deep": { "$value": "#e9e5dc", "$description": "Sunken areas: map surroundings, empty photo slots" },
    "surface": { "$value": "#ffffff", "$description": "Cards, panels, dialogs, the top bar" },
    "surface-2": { "$value": "#f8f6f1", "$description": "Inset blocks inside cards" },
    "ink": { "$value": "#0a2239", "$description": "Main text" },
    "ink-2": { "$value": "#716a5c", "$description": "Secondary text" },
    "ink-3": { "$value": "#9b9385", "$description": "Hints, timestamps, placeholders" },
    "line": { "$value": "#e0dbd1", "$description": "Borders and dividers" },
    "line-strong": { "$value": "#cdc6b8", "$description": "Input borders" },
    "brand": { "$value": "#60712f", "$description": "Park green: primary buttons, links, progress" },
    "brand-strong": { "$value": "#46531f", "$description": "Text on brand-soft; primary hover" },
    "brand-soft": { "$value": "#e6eed3", "$description": "Mint: zoo chips, quick-link tile, selected states" },
    "brand-ink": { "$value": "#ffffff", "$description": "Text on brand" },
    "cta": { "$value": "#0a2239", "$description": "Primary buttons: navy with lime text on light surfaces (lime on navy bands)" },
    "cta-ink": { "$value": "#dceab2", "$description": "Text on cta" },
    "cta-hover": { "$value": "#12304d", "$description": "Primary button hover" },
    "accent": { "$value": "#e0782f", "$description": "Design-motivation label, highlights" },
    "accent-soft": { "$value": "#f1e7d3", "$description": "Beige: design-motivation boxes, survey callouts" },
    "accent-ink": { "$value": "#b25a1c", "$description": "Text on accent-soft" },
    "danger": { "$value": "#c0453b" },
    "danger-soft": { "$value": "#f8e3e0" },
    "info": { "$value": "#3157e3" },
    "coaster": { "$value": "#ff4d8d", "$description": "Theme-park pink" },
    "coaster-soft": { "$value": "#ffe1ed" },
    "coaster-ink": { "$value": "#a81754", "$description": "Text on coaster-soft" },
    "lavender": { "$value": "#dcebea", "$description": "Social quick-link tile" },
    "cream": { "$value": "#ece6d6", "$description": "Date chip on the welcome banner" },
    "hero": { "$value": "#0a2239", "$description": "Welcome banner and profile card background" },
    "deep": { "$value": "#12304d", "$description": "Dark green cards (next step, design principle)" },
    "navy": { "$value": "#1d1f4a", "$description": "Theme-park planner bar (Figma: Neon Pier)" },
    "lp-navy": { "$value": "#0a2239", "$description": "Landing: deep navy hero background (same in both themes)" },
    "lp-lime": { "$value": "#dceab2", "$description": "Landing: pastel lime primary buttons" },
    "lp-sage": { "$value": "#a8ccc9", "$description": "Landing: sage teal tags, poll bars, active highlights" },
    "lp-olive": { "$value": "#60712f", "$description": "Landing: olive category pills" },
    "lp-taupe": { "$value": "#716a5c", "$description": "Landing: taupe borders and secondary text on light sections" },
    "on-dark": { "$value": "#d5dde6", "$description": "Body text on hero/deep" },
    "on-dark-2": { "$value": "#c4d0db", "$description": "Small text on deep" },
    "lime": { "$value": "#dceab2", "$description": "Labels and progress on dark green" },
    "poll-bg": { "$value": "#f4f7ec", "$description": "Question box inside posts" },
    "poll-line": { "$value": "#dfe5cb" },
    "positive": { "$value": "#60712f", "$description": "Stats going up" },
    "heart": { "$value": "#ff4d8d", "$description": "Likes and the notification badge" },
    "ground": { "$value": "#cdd9b0", "$description": "Map ground" },
    "ground-ink": { "$value": "#1d2b1f", "$description": "Text on the map ground" },
    "ground-line": { "$value": "#364f2821", "$description": "Minor grid lines" },
    "ground-line-major": { "$value": "#364f2842", "$description": "Major grid lines" },
    "ground-tuft": { "$value": "#4f6e2f40", "$description": "Grass speckles on the map ground" },
    "hedge": { "$value": "#5b7f43", "$description": "Hedge around the edge of a park map" },
    "ground-glow": { "$value": "#ffffff1a", "$description": "Sunny patches on the map ground" },
    "ground-shade": { "$value": "#2f4a2210", "$description": "Shaded patches on the map ground" },
    "map-border": { "$value": "#364f2873", "$description": "Edge of the map" },
    "dots": { "$value": "#0a223914", "$description": "Dotted backdrop behind maps" },
    "selection": { "$value": "#dceab2", "$description": "Selected text" },
    "glass": { "$value": "#ffffffeb", "$description": "Floating pills and labels over maps" },
    "nav-bg": { "$value": "#ffffff", "$description": "Top navigation" },
    "nav-bg-solid": { "$value": "#fffffff5", "$description": "Bottom tab bar on phones" },
    "hover-tint": { "$value": "#0a22390d", "$description": "Hover background for quiet buttons" },
    "focus-ring": { "$value": "#60712f40", "$description": "Glow around focused inputs" },
    "backdrop": { "$value": "#0a223980", "$description": "Behind dialogs" },
    "inverse-bg": { "$value": "#0a2239", "$description": "Toasts, drawing hints, map labels" },
    "inverse-ink": { "$value": "#ffffff" },
    "inverse-muted": { "$value": "#a9b6c4" }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-sm": { "$value": [{ "color": "#0a22390d", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "shadow": { "$value": [{ "color": "#0a223912", "offsetX": "0px", "offsetY": "10px", "blur": "30px", "spread": "0px" }] },
    "shadow-lg": {
      "$value": [
        { "color": "#0a223914", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" },
        { "color": "#0a223938", "offsetX": "0px", "offsetY": "24px", "blur": "60px", "spread": "-20px" }
      ]
    }
  }
}
