{
  "$description": "Talyxel Park — dark theme, derived from the Parkmakers Figma palette. Same token names as theme.light.json; in Figma these are the two modes of one collection.",
  "color": {
    "$type": "color",
    "bg": { "$value": "#101511", "$description": "Page background" },
    "bg-deep": { "$value": "#0b0f0c", "$description": "Sunken areas: map surroundings, empty photo slots" },
    "surface": { "$value": "#182019", "$description": "Cards, panels, dialogs, the top bar" },
    "surface-2": { "$value": "#1d261f", "$description": "Inset blocks inside cards" },
    "ink": { "$value": "#e9eee9", "$description": "Main text" },
    "ink-2": { "$value": "#a9b4ac", "$description": "Secondary text" },
    "ink-3": { "$value": "#7d8981", "$description": "Hints, timestamps, placeholders" },
    "line": { "$value": "#2a342d", "$description": "Borders and dividers" },
    "line-strong": { "$value": "#3a463e", "$description": "Input borders" },
    "brand": { "$value": "#6fae86", "$description": "Park green: primary buttons, links, progress" },
    "brand-strong": { "$value": "#b5dcc1", "$description": "Text on brand-soft; primary hover" },
    "brand-soft": { "$value": "#1f3428", "$description": "Mint: zoo chips, quick-link tile, selected states" },
    "brand-ink": { "$value": "#0f1a13", "$description": "Text on brand" },
    "accent": { "$value": "#ef9a5a", "$description": "Design-motivation label, highlights" },
    "accent-soft": { "$value": "#3a2d1c", "$description": "Beige: design-motivation boxes, survey callouts" },
    "accent-ink": { "$value": "#f4bb8c", "$description": "Text on accent-soft" },
    "danger": { "$value": "#e5796d" },
    "danger-soft": { "$value": "#3b2220" },
    "info": { "$value": "#7f9bff" },
    "coaster": { "$value": "#ff5c96", "$description": "Theme-park pink" },
    "coaster-soft": { "$value": "#3d1e2b" },
    "coaster-ink": { "$value": "#ff9cc0", "$description": "Text on coaster-soft" },
    "lavender": { "$value": "#25243a", "$description": "Social quick-link tile" },
    "cream": { "$value": "#3a3326", "$description": "Date chip on the welcome banner" },
    "hero": { "$value": "#0b100c", "$description": "Welcome banner and profile card background" },
    "deep": { "$value": "#1c3227", "$description": "Dark green cards (next step, design principle)" },
    "on-dark": { "$value": "#c8d0cb", "$description": "Body text on hero/deep" },
    "on-dark-2": { "$value": "#a9bdb0", "$description": "Small text on deep" },
    "lime": { "$value": "#b9d47b", "$description": "Labels and progress on dark green" },
    "poll-bg": { "$value": "#172019", "$description": "Question box inside posts" },
    "poll-line": { "$value": "#2c3a2f" },
    "positive": { "$value": "#7ccf97", "$description": "Stats going up" },
    "heart": { "$value": "#ff5c96", "$description": "Likes and the notification badge" },
    "ground": { "$value": "#2c3826", "$description": "Map ground" },
    "ground-ink": { "$value": "#e4ecda", "$description": "Text on the map ground" },
    "ground-line": { "$value": "#dcebd212", "$description": "Minor grid lines" },
    "ground-line-major": { "$value": "#dcebd224", "$description": "Major grid lines" },
    "map-border": { "$value": "#dcebd240", "$description": "Edge of the map" },
    "dots": { "$value": "#e9eee912", "$description": "Dotted backdrop behind maps" },
    "selection": { "$value": "#2d4a36", "$description": "Selected text" },
    "glass": { "$value": "#182019eb", "$description": "Floating pills and labels over maps" },
    "nav-bg": { "$value": "#182019", "$description": "Top navigation" },
    "nav-bg-solid": { "$value": "#182019f5", "$description": "Bottom tab bar on phones" },
    "hover-tint": { "$value": "#e9eee90f", "$description": "Hover background for quiet buttons" },
    "focus-ring": { "$value": "#6fae864d", "$description": "Glow around focused inputs" },
    "backdrop": { "$value": "#000000a3", "$description": "Behind dialogs" },
    "inverse-bg": { "$value": "#e9eee9", "$description": "Toasts, drawing hints, map labels" },
    "inverse-ink": { "$value": "#182019" },
    "inverse-muted": { "$value": "#56645b" }
  },
  "shadow": {
    "$type": "shadow",
    "shadow-sm": { "$value": [{ "color": "#00000059", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" }] },
    "shadow": { "$value": [{ "color": "#00000066", "offsetX": "0px", "offsetY": "10px", "blur": "30px", "spread": "0px" }] },
    "shadow-lg": {
      "$value": [
        { "color": "#00000066", "offsetX": "0px", "offsetY": "4px", "blur": "12px", "spread": "0px" },
        { "color": "#000000b3", "offsetX": "0px", "offsetY": "24px", "blur": "60px", "spread": "-20px" }
      ]
    }
  }
}
